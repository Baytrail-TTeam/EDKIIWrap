  "root_cause": {
    "baseline": "Exact Win10 ISO with CPU-EXIT enters kernel then bugchecks 5C, 8000, B, 0, 0; HaliHaltSystem loops without visible bugcheck text.",
    "trace": "HalpAcpiFindRsdp finds ACPI configuration but HalpAcpiAllocateMemory returns NULL. Exact ntoskrnl disassembly sets upper physical address 0x1000000 before allocating from loader memory list. ACPI cache initialization returns STATUS_INSUFFICIENT_RESOURCES (C000009A); interrupt initialization later fails.",
    "symbol_source": "https://msdl.microsoft.com/download/symbols/ntkrnlmp.pdb/89284D0CA6ACC8274B9A44BD5AF9290B1/ntkrnlmp.pdb",
    "kernel_sha256": "eace65a06bab6b67461ed29783cde9367c3ddd2a31b2594c59d22d77460d4f4b"
  },
  "change": {
    "main_arena_mib": 1024,
    "low_arena_mib": 4,
    "low_range": "Stock AllocateMaxAddress below 16 MiB, base at least 1 MiB; failure returns through stock cleanup. No stock reserved memory released.",
    "handoff": "M3 v2, 2400 bytes; common Handoff v1 stays 2312 bytes. Low fields explicitly validated; no merging of old/new payload ABI.",
    "typed_reservations": "ACPI/NVS/runtime stock ranges described as SystemMemory and fully consumed by typed Allocation HOBs, because DXE ignores allocation types on GCD Reserved resources. Probe verifies exact types plus ConventionalMemory containment in the two explicitly owned arenas.",
    "dma": "Owned predicate now accepts either acquired arena; no weakened 4 GiB limit."
  },

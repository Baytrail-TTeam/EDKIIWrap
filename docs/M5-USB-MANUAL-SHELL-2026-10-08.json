  "physical_reference": "MANUAL-TEST-M5-USB-FILE-2026-10-08.json",
  "changes": [
    "Enter embedded Shell directly; no automatic USB BOOTX64 lookup, hash check or launch",
    "Finish discovery as soon as USB FAT and keyboard are ready",
    "Connect each USB/BlockIo handle once; no repeated block connection log",
    "Disable normal transfer framebuffer diagnostics",
    "Package optional sample under EFI/SAMPLES/USBTEST.EFI to preserve user BOOTX64"
  ],
  "tests": [
    "Assert no test-app marker before typing manual Shell commands",
    "Manually launch USB BOOTX64 from fs1, return and execute keyboard command",
    "Nonmatching USB file does not block Shell startup",
    "No-keyboard rejection remains intact",
    "USB disk images remain unchanged"
  ],
  "timing_limits": "seconds_to_shell_ready includes QEMU firmware boot and polling overhead; not a physical tablet benchmark",
  "limitations": [
    "15 second discovery cap is bypassed on readiness; synchronous driver calls can take longer",
    "Per-handle bootstrap tracking does not guarantee hotplug handle reuse",
    "120 second read watchdog retained; not a promise of completion",
    "USB writes remain denied"
  ],
